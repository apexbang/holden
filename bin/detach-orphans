#!/usr/bin/env node
'use strict';
// detach-orphans: list detached runs that finished, unseen, after their launching session went away.
// The Stop hook alerts only the session that launched a run and detach-wait dies with it, so these
// answers would sit unread. A session is live while ~/.claude/sessions/<pid>.json names it and that
// pid runs with the recorded start time, so a reused pid does not count. A run with no recorded
// session is left out: the Stop hook still alerts every session.
const fs = require('fs'), path = require('path'), os = require('os');
const R = path.join(os.homedir(), '.claude', 'detached'), S = path.join(os.homedir(), '.claude', 'sessions');
const read = f => { try { return fs.readFileSync(f, 'utf8'); } catch (e) { return null; } };
const alive = pid => { try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; } };

// Field 22 of /proc/<pid>/stat; the name before it can hold spaces, so count from its closing bracket.
const startOf = pid => { const s = read(`/proc/${pid}/stat`); return s ? s.slice(s.lastIndexOf(')') + 2).split(' ')[19] : null; };

function liveSessions() {
  const live = new Set();
  let names = []; try { names = fs.readdirSync(S); } catch (e) {}
  for (const n of names.filter(x => x.endsWith('.json'))) {
    try { const j = JSON.parse(read(path.join(S, n))); if (j.sessionId && alive(j.pid) && (j.procStart == null || String(j.procStart) === startOf(j.pid))) live.add(j.sessionId); } catch (e) {}
  }
  return live;
}

let runs = []; try { runs = fs.readdirSync(R).filter(f => f.endsWith('.run')); } catch (e) {}
const live = liveSessions();
for (const f of runs.sort()) {
  const name = f.slice(0, -4), run = read(path.join(R, f)) || '';
  const session = (run.match(/^session=(.*)$/m) || [])[1];
  if (!session || live.has(session) || fs.existsSync(path.join(R, `${name}.seen`))) continue;
  const out = path.join(R, `${name}.out`), exit = ((read(out) || '').match(/^EXIT \d+$/gm) || []).pop();
  if (exit) console.log(`${name}: ${exit}, its session is gone; read ${out}, then detach-seen ${name}`);
}
